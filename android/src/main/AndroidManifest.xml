<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Raw TCP needs only INTERNET, which every Capacitor host already
         declares. Declared here too so the plugin is self-sufficient; the
         manifest merger de-duplicates identical declarations. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
